{
  "name": "durable-machines-monorepo",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "pnpm --filter durable-machines build && pnpm --filter @durable-machines/example-bank build",
    "check": "pnpm -r --if-present typecheck && pnpm --filter @durable-machines/example-ci check:graph && pnpm --filter @durable-machines/example-bank check:graph",
    "dev": "pnpm --filter @durable-machines/example-bank dev",
    "dev:ci": "pnpm --filter @durable-machines/example-ci dev",
    "deploy": "pnpm --filter @durable-machines/example-bank run deploy"
  },
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@12.8.1"
}
